---
import '@app/styles/globals.css';
import { THEME_INIT_SCRIPT } from '@features/theme';
import { TrophyHost } from '@features/trophies';
import { CursorHost } from '@features/cursor';

interface Props {
  title?: string;
}

const { title = 'Matías García' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline set:html={THEME_INIT_SCRIPT} />
    <script is:inline>
      (function () {
        console.log(
          '%cMatías García',
          'font-family:Georgia,serif;font-size:24px;color:oklch(0.7 0.2 243);font-weight:bold',
        );
        console.log(
          '%cFull-stack engineer integrating AI into how teams ship\n→ github.com/matgarfer499\n\nRun window.matias.unlock() to claim your trophy.',
          'font-size:12px;font-family:monospace;color:#888',
        );
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <TrophyHost client:idle />
    <CursorHost client:only="react" />
  </body>
</html>
