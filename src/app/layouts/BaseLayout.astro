---
import '@app/styles/globals.css';
import { THEME_INIT_SCRIPT } from '@features/theme';

interface Props {
  title?: string;
}

const { title = 'Matías García' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline set:html={THEME_INIT_SCRIPT} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
