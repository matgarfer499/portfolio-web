---
import BaseLayout from '@app/layouts/BaseLayout.astro';
---

<BaseLayout title="CV — Matías García">
  <main class="mx-auto max-w-[640px] px-6 py-20 md:py-32">
    <h1 class="font-serif text-4xl">CV</h1>
    <p class="text-fg-muted mt-4">Full web version coming soon.</p>
    <a
      href="/cv.pdf"
      download="Matias-Garcia-CV.pdf"
      class="border-border bg-surface text-fg focus-visible:outline-accent mt-8 inline-flex h-12 items-center gap-2 rounded-lg border px-6 font-mono text-base tracking-wide uppercase hover:bg-neutral-200 focus-visible:outline-2 focus-visible:outline-offset-2 motion-safe:transition-colors motion-safe:duration-[150ms] dark:hover:bg-neutral-800"
    >
      Download CV (PDF)
    </a>
  </main>
</BaseLayout>
