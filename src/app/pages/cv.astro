---
import BaseLayout from '@app/layouts/BaseLayout.astro';
import { CONTACTS } from '@features/contact/lib/contacts';

const contactLinks = CONTACTS.filter((c) => c.kind !== 'cv');
---

<BaseLayout title="CV — Matías García">
  <main class="mx-auto max-w-[640px] px-6 py-20 md:py-32">
    <p class="text-fg-muted mb-3 font-mono text-sm tracking-widest uppercase">Curriculum Vitae</p>
    <h1 class="font-serif text-4xl">Matías García</h1>
    <p class="text-fg-muted mt-2 font-mono text-sm">
      Full-stack engineer · Málaga, Spain · EU remote
    </p>

    <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
      {
        contactLinks.map((contact) => (
          <a
            href={contact.href}
            aria-label={contact.ariaLabel}
            {...(contact.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            class="text-fg-muted hover:text-accent focus-visible:outline-accent font-mono text-sm focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            {contact.kind === 'email' ? contact.display : contact.label}
          </a>
        ))
      }
    </div>

    <hr class="border-border my-8" />

    <p class="text-fg leading-relaxed">
      I'm focused on integrating AI into developer workflows — not as a novelty, but as a way to
      remove the repetitive work so the team can concentrate on the hard problems. I work remotely
      for a Spanish energy company and keep my tools sharp for EU opportunities.
    </p>

    <a
      href="/cv.pdf"
      download="Matias-Garcia-CV.pdf"
      class="border-border bg-surface text-fg focus-visible:outline-accent mt-10 inline-flex h-12 items-center gap-2 rounded-lg border px-6 font-mono text-base tracking-wide uppercase hover:bg-neutral-200 focus-visible:outline-2 focus-visible:outline-offset-2 motion-safe:transition-colors motion-safe:duration-[150ms] dark:hover:bg-neutral-800"
    >
      Download CV (PDF)
    </a>
  </main>
</BaseLayout>
