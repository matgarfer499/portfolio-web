---
import BaseLayout from '@app/layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page not found · Matías García">
  <main
    data-page="404"
    class="flex min-h-dvh flex-col items-center justify-center px-6 text-center"
  >
    <p class="text-fg-muted mb-4 font-mono text-sm tracking-widest uppercase">Error 404</p>
    <h1 class="text-fg mb-4 font-serif text-6xl md:text-8xl">Lost?</h1>
    <p class="text-fg-muted mb-10 max-w-sm text-lg">
      This page wandered off the path. Let's get you back.
    </p>
    <pre
      class="text-fg-muted mb-10 font-mono text-sm leading-relaxed select-none"
      aria-hidden="true">    N
W --+-- E
    S</pre>
    <a
      href="/"
      class="bg-accent text-accent-fg focus-visible:outline-accent inline-flex h-12 items-center rounded-lg px-6 font-mono text-base font-medium tracking-wide uppercase hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 motion-safe:transition-opacity motion-safe:duration-[120ms]"
    >
      Back home
    </a>
  </main>
</BaseLayout>
