---
import {
  EnvelopeIcon,
  FileArrowDownIcon,
  GithubLogoIcon,
  LinkedinLogoIcon,
} from '@phosphor-icons/react/dist/ssr';
import type { ContactEntry } from '../lib/contacts';

type Props = { readonly entry: ContactEntry };

const { entry } = Astro.props;

const iconMap = {
  email: EnvelopeIcon,
  linkedin: LinkedinLogoIcon,
  github: GithubLogoIcon,
  cv: FileArrowDownIcon,
} as const;

const Icon = iconMap[entry.kind];
---

<a
  href={entry.href}
  aria-label={entry.ariaLabel}
  target={entry.external ? '_blank' : null}
  rel={entry.external ? 'noopener noreferrer' : null}
  download={entry.download ?? null}
  class="group text-fg focus-visible:text-accent focus-visible:outline-accent flex min-h-11 w-full items-center gap-4 px-1 py-3 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2"
>
  <Icon size={18} weight="light" className="flex-shrink-0 opacity-70" />
  <span class="text-base underline-offset-4 group-focus-visible:underline">
    {entry.label}
  </span>
  <span class="flex-1"></span>
  <span class="text-fg-muted group-focus-visible:text-accent truncate font-mono text-sm">
    {entry.display}
  </span>
</a>
