---
import type { MarkdownInstance } from 'astro';

type Props = { Content: MarkdownInstance<Record<string, unknown>>['Content'] };
const { Content } = Astro.props;
---

<div class="about-bio motion-safe:animate-fade-up mt-12">
  <Content />
</div>

<style is:global>
  .about-bio h3 {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 2.5rem;
  }
  .about-bio h3:first-child {
    margin-top: 0;
  }
  .about-bio p {
    color: var(--color-fg);
    margin-top: 0.5rem;
    line-height: 1.625;
  }
  .about-bio strong {
    font-weight: 500;
  }
</style>
