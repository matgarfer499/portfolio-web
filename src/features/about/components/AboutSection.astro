---
import { getCollection, render } from 'astro:content';
import { Container, Eyebrow, Heading } from '@shared/ui';
import AboutBio from './AboutBio.astro';
import AboutNote from './AboutNote.astro';
import AboutValues from './AboutValues.astro';

const entries = await getCollection('about');
const entry = entries[0];
if (!entry) return null;

const { Content } = await render(entry);
const { title, values, note } = entry.data;
---

<section id="about" class="py-20 md:py-32" aria-labelledby="about-heading">
  <Container>
    <div class="mx-auto max-w-[840px]">
      <Eyebrow>04 · About</Eyebrow>
      <Heading level={2} id="about-heading" className="mt-2">{title}</Heading>

      <AboutBio Content={Content} />
      <AboutValues values={values} />
      <AboutNote note={note} />
    </div>
  </Container>
</section>
