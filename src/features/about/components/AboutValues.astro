---
type Value = { lead: string; body: string };
type Props = { values: ReadonlyArray<Value> };

const { values } = Astro.props;
if (values.length === 0) return null;
---

<dl class="motion-safe:animate-fade-up mt-12 space-y-6" style={{ animationDelay: '80ms' }}>
  {
    values.map((value) => (
      <div class="flex flex-col gap-1 md:flex-row md:items-baseline md:gap-3">
        <dt class="text-fg shrink-0 font-mono text-sm font-medium">{value.lead}</dt>
        <dd class="text-fg-muted leading-relaxed">{value.body}</dd>
      </div>
    ))
  }
</dl>
