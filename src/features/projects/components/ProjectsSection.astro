---
import { getCollection } from 'astro:content';
import { Container, Eyebrow, Heading } from '@shared/ui';
import { sortProjects } from '../lib/sortProjects';
import EmptyState from './EmptyState.astro';
import ProjectCard from './ProjectCard.astro';

const allProjects = await getCollection('projects');
const projects = allProjects.sort(sortProjects);
---

<section id="projects" data-cursor-zone="true" class="py-20 md:py-32">
  <Container>
    <Eyebrow>02 · Work</Eyebrow>
    <Heading level={2} className="mt-2">Selected projects</Heading>

    <div class="mt-12">
      {
        projects.length === 0 ? (
          <EmptyState />
        ) : (
          <div class="grid gap-8 lg:grid-cols-2">
            {projects.map((project, index) => (
              <ProjectCard project={project} index={index} />
            ))}
          </div>
        )
      }
    </div>
  </Container>
</section>
