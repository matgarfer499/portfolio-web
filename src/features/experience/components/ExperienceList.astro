---
import type { CollectionEntry } from 'astro:content';
import ExperienceItem from './ExperienceItem.astro';

type Props = { experiences: CollectionEntry<'experiences'>[] };

const { experiences } = Astro.props;
---

<ol class="mt-12 list-none p-0">
  {experiences.map((entry, index) => <ExperienceItem entry={entry} index={index} />)}
</ol>
